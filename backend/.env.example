# ===== Agent-Bench 环境配置模板 =====
# 复制为 .env 并填入真实值

# 被测内置 Agent 使用的 LLM（OpenAI 兼容协议）
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=sk-xxx
LLM_MODEL=deepseek-flash
LLM_TEMPERATURE=0.0

# Judge 评分模型（可与被测不同供应商，避免自我偏好；留空回落 LLM_*)
JUDGE_BASE_URL=
JUDGE_API_KEY=
JUDGE_MODEL=

# 流水线
EXEC_CONCURRENCY=3
JUDGE_CONCURRENCY=3
PASS_THRESHOLD=3
AGENT_TIMEOUT_SECONDS=300
JUDGE_MAX_RETRIES=2

# 访问控制
# 设置后，除 /api/system/health 外的所有 /api/* 需要 Authorization: Bearer <token>
# 对外开放监听（HOST=0.0.0.0）时必须设置；本地默认 127.0.0.1 可不设
# AUTH_TOKEN=change-me
# 跨域白名单（逗号分隔）；留空 = 不启用 CORS（仅同源，最安全默认）
# CORS_ORIGINS=http://localhost:5173

# 数据库（默认 SQLite；切 MySQL 示例：mysql+pymysql://user:pwd@host:3306/agent_bench）
# DATABASE_URL=

# Langfuse（可选；未配置自动降级本地 JSON Trace → backend/data/traces/）
# LANGFUSE_PUBLIC_KEY=pk-lf-xxx
# LANGFUSE_SECRET_KEY=sk-lf-xxx
# LANGFUSE_HOST=http://localhost:3000
